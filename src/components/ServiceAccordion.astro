---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  text: string;
  tag: string;
  icon: string;
  details: string[];
  index: number;
}

const { title, text, tag, icon, details, index } = Astro.props;
const triggerId = `service-trigger-${index}`;
const contentId = `service-content-${index}`;
---

<div class="accordion-item" data-accordion-item data-accordion-index={index}>
  <button class="accordion-trigger" type="button" id={triggerId} aria-expanded="false" aria-controls={contentId} data-accordion-trigger>
    <span class="icon-box">
      <Icon name={icon} />
    </span>
    <span class="accordion-title-wrap">
      <h3>{title}</h3>
    </span>
    <span class="tag">{tag}</span>
    <span class="accordion-icon">
      <Icon name="chevron" size={16} />
    </span>
  </button>
  <div class="accordion-content" id={contentId} role="region" aria-labelledby={triggerId} data-accordion-content>
    <div class="accordion-inner">
      <p class="accordion-desc">{text}</p>
      <ul class="accordion-list">
        {details.map((detail) => (
          <li>
            <Icon name="check" size={14} />
            <span>{detail}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .accordion-item {
    border: 1px solid var(--color-outline);
    border-radius: 12px;
    background: rgba(22, 22, 24, 0.5);
    overflow: hidden;
    transition: border-color 300ms ease, background 300ms ease;
  }

  .accordion-item.is-open {
    border-color: var(--color-outline-strong);
    background: rgba(28, 28, 30, 0.7);
  }

  .accordion-trigger {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 16px 20px;
    border: none;
    background: transparent;
    color: var(--color-on-surface);
    cursor: pointer;
    text-align: left;
    gap: 14px;
    transition: background 200ms ease;
  }

  .accordion-trigger:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .icon-box {
    flex-shrink: 0;
  }

  .accordion-title-wrap {
    flex: 1;
    min-width: 0;
  }

  h3 {
    margin: 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .tag {
    flex-shrink: 0;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(41, 151, 255, 0.08);
    color: var(--color-primary-soft);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0;
  }

  .accordion-icon {
    flex-shrink: 0;
    color: var(--color-on-surface-muted);
    transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94), color 200ms ease;
  }

  .accordion-item.is-open .accordion-icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .accordion-content {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 350ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .accordion-item.is-open .accordion-content {
    grid-template-rows: 1fr;
  }

  .accordion-inner {
    overflow: hidden;
  }

  .accordion-inner > * {
    padding: 0 20px 20px;
  }

  .accordion-desc {
    margin: 0 0 14px;
    color: var(--color-on-surface-muted);
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: -0.01em;
  }

  .accordion-list {
    display: grid;
    gap: 8px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .accordion-list li {
    display: flex;
    align-items: start;
    gap: 10px;
    color: var(--color-on-surface-muted);
    font-size: 13px;
    line-height: 1.5;
    letter-spacing: -0.01em;
  }

  .accordion-list svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-primary);
  }

  @media (max-width: 600px) {
    .accordion-trigger {
      gap: 10px;
      padding: 14px 16px;
    }

    .tag {
      max-width: 100px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  @media (max-width: 400px) {
    .accordion-trigger {
      flex-wrap: wrap;
    }

    .accordion-title-wrap {
      min-width: calc(100% - 50px);
      order: -1;
    }

    .tag {
      order: 1;
      margin-left: 52px;
    }
  }
</style>
