---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  align?: "left" | "center";
}

const { eyebrow, title, text, align = "left" } = Astro.props;
---

<div class:list={["section-intro", align]}>
  <span class="eyebrow">{eyebrow}</span>
  <h2 class="section-title">{title}</h2>
  {text && <p class="lead">{text}</p>}
</div>

<style>
  .section-intro {
    display: grid;
    max-width: 720px;
    gap: 14px;
    margin-bottom: 40px;
  }

  .section-intro.center {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  @media (max-width: 680px) {
    .section-intro {
      margin-bottom: 24px;
    }
  }
</style>
