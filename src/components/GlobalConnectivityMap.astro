---
import Icon from "./Icon.astro";
---

<div class="connectivity-map panel">
  <div class="map-overlay">
    <div class="overlay-header">
      <span class="eyebrow">Red activa</span>
      <h4>Ecosistema de Conexión ISI</h4>
      <p>Nuestra infraestructura global cifrada de baja latencia y alta redundancia.</p>
    </div>
    <div class="live-status-pill">
      <span class="live-dot animate-ping"></span>
      <span>MONITOR DE RED: 100% OPERACIONAL</span>
    </div>
  </div>

  <div class="map-canvas-container">
    <svg class="world-map-svg" viewBox="0 0 800 450" fill="none" xmlns="http://www.w3.org/2000/svg">
      <!-- Grid pattern for technical look -->
      <defs>
        <pattern id="technical-grid" width="30" height="30" patternUnits="userSpaceOnUse">
          <path d="M 30 0 L 0 0 0 30" fill="none" stroke="rgba(255, 255, 255, 0.015)" stroke-width="1"/>
        </pattern>
        <radialGradient id="map-glow" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.1" />
          <stop offset="100%" stop-color="transparent" stop-opacity="0" />
        </radialGradient>
      </defs>

      <!-- Background glow -->
      <rect width="800" height="450" fill="url(#technical-grid)"/>
      <circle cx="400" cy="225" r="300" fill="url(#map-glow)" />

      <!-- Stylized continental lines (constellation network lines for tech aesthetic) -->
      <!-- Americas outline connection -->
      <path d="M 120 80 L 220 80 L 260 180 L 220 280 L 250 360 L 290 410 L 250 420 L 190 320 L 170 240 L 110 150 Z" 
            fill="rgba(255, 255, 255, 0.01)" stroke="rgba(255, 255, 255, 0.03)" stroke-width="1" />
      <!-- Europe & Africa outline connection -->
      <path d="M 450 80 L 580 60 L 620 120 L 580 200 L 530 260 L 550 380 L 500 410 L 460 320 L 430 200 Z" 
            fill="rgba(255, 255, 255, 0.01)" stroke="rgba(255, 255, 255, 0.03)" stroke-width="1" />

      <!-- Encrypted Tunnel Lines (Bezier Curves) -->
      <!-- Medellín <-> Miami -->
      <path id="tunnel-medellin-miami" d="M 230 290 Q 210 200 240 160" 
            fill="none" stroke="rgba(41, 151, 255, 0.15)" stroke-width="2" stroke-dasharray="6 4" />
      <!-- Bogotá <-> Miami -->
      <path id="tunnel-bogota-miami" d="M 255 310 Q 230 210 240 160" 
            fill="none" stroke="rgba(41, 151, 255, 0.15)" stroke-width="2" stroke-dasharray="6 4" />
      <!-- Miami <-> Frankfurt -->
      <path id="tunnel-miami-frankfurt" d="M 240 160 Q 380 90 520 110" 
            fill="none" stroke="rgba(94, 92, 230, 0.15)" stroke-width="2" stroke-dasharray="6 4" />
      <!-- Medellín <-> Frankfurt (Backup Line) -->
      <path id="tunnel-medellin-frankfurt" d="M 230 290 Q 380 220 520 110" 
            fill="none" stroke="rgba(94, 92, 230, 0.08)" stroke-width="1.5" stroke-dasharray="8 6" />

      <!-- Active Glowing Lines for animated data packets -->
      <!-- Medellín <-> Miami Active -->
      <path d="M 230 290 Q 210 200 240 160" fill="none" stroke="var(--color-primary)" stroke-width="2" 
            stroke-linecap="round" opacity="0.8" class="map-active-path" />
      <!-- Bogotá <-> Miami Active -->
      <path d="M 255 310 Q 230 210 240 160" fill="none" stroke="var(--color-primary)" stroke-width="2" 
            stroke-linecap="round" opacity="0.8" class="map-active-path" />
      <!-- Miami <-> Frankfurt Active -->
      <path d="M 240 160 Q 380 90 520 110" fill="none" stroke="var(--color-secondary)" stroke-width="2" 
            stroke-linecap="round" opacity="0.8" class="map-active-path" />

      <!-- Animated Data Packet Particles -->
      <!-- Packet 1: Med <-> Miami -->
      <circle r="4" fill="#ffffff" filter="drop-shadow(0 0 6px var(--color-primary))">
        <animateMotion dur="3.5s" repeatCount="indefinite" path="M 230 290 Q 210 200 240 160" />
      </circle>
      <!-- Packet 2: Bog <-> Miami -->
      <circle r="4" fill="#ffffff" filter="drop-shadow(0 0 6px var(--color-primary))">
        <animateMotion dur="2.8s" repeatCount="indefinite" path="M 255 310 Q 230 210 240 160" />
      </circle>
      <!-- Packet 3: Miami <-> Frankfurt -->
      <circle r="4" fill="#ffffff" filter="drop-shadow(0 0 6px var(--color-secondary))">
        <animateMotion dur="4.2s" repeatCount="indefinite" path="M 240 160 Q 380 90 520 110" />
      </circle>
      <!-- Packet 4 (Reverse): Frankfurt <-> Miami -->
      <circle r="4" fill="var(--color-primary-soft)" opacity="0.8">
        <animateMotion dur="5s" repeatCount="indefinite" path="M 520 110 Q 380 90 240 160" />
      </circle>
    </svg>

    <!-- HTML Glowing City Markers Overlay -->
    <!-- Medellín -->
    <div class="map-marker active" style="left: 28.7%; top: 64.4%;">
      <span class="marker-ping animate-ping"></span>
      <span class="marker-core"></span>
      <div class="marker-card">
        <strong>Medellín (HQ)</strong>
        <span>ISI Central Labs</span>
        <span class="badge latency">Continuidad alta</span>
      </div>
    </div>

    <!-- Bogotá -->
    <div class="map-marker active" style="left: 31.8%; top: 68.8%;">
      <span class="marker-ping animate-ping"></span>
      <span class="marker-core"></span>
      <div class="marker-card">
        <strong>Bogotá DC</strong>
        <span>Operations Hub</span>
        <span class="badge uptime">Latencia: 14ms</span>
      </div>
    </div>

    <!-- Miami -->
    <div class="map-marker edge" style="left: 30.0%; top: 35.5%;">
      <span class="marker-ping animate-ping"></span>
      <span class="marker-core"></span>
      <div class="marker-card">
        <strong>Miami (Edge Node)</strong>
        <span>Equinix NAP Americas</span>
        <span class="badge speed">Transit: 10 Gbps</span>
      </div>
    </div>

    <!-- Frankfurt -->
    <div class="map-marker core" style="left: 65.0%; top: 24.4%;">
      <span class="marker-ping animate-ping"></span>
      <span class="marker-core"></span>
      <div class="marker-card">
        <strong>Frankfurt DC</strong>
        <span>Main Cloud Gateway</span>
        <span class="badge safe">ISO 27001</span>
      </div>
    </div>
  </div>
</div>

<style>
  .connectivity-map {
    position: relative;
    width: 100%;
    border-radius: 20px;
    background: rgba(10, 10, 14, 0.7);
    border: 1px solid var(--color-outline);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    aspect-ratio: 16 / 10;
  }

  .map-overlay {
    position: absolute;
    top: 24px;
    left: 24px;
    right: 24px;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    pointer-events: none;
  }

  .overlay-header {
    max-width: 320px;
  }

  .overlay-header h4 {
    margin: 6px 0 4px 0;
    font-size: 18px;
    font-weight: 600;
    color: #ffffff;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .overlay-header p {
    margin: 0;
    font-size: 11px;
    color: var(--color-on-surface-muted);
    line-height: 1.4;
  }

  .live-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 980px;
    background: rgba(48, 209, 88, 0.08);
    border: 1px solid rgba(48, 209, 88, 0.15);
    color: #30d158;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #30d158;
    box-shadow: 0 0 6px #30d158;
  }

  .map-canvas-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .world-map-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
  }

  /* HTML map markers overlay */
  .map-marker {
    position: absolute;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    cursor: pointer;
    z-index: 10;
  }

  .marker-core {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #ffffff;
    border: 2.5px solid var(--theme-color, var(--color-primary));
    box-shadow: 0 0 8px var(--theme-color, var(--color-primary));
    transition: transform 300ms cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .marker-ping {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid var(--theme-color, var(--color-primary));
    opacity: 0.8;
  }

  .map-marker.active { --theme-color: var(--color-primary); }
  .map-marker.edge { --theme-color: var(--color-primary-soft); }
  .map-marker.core { --theme-color: var(--color-secondary-soft); }

  /* Marker Hover Spec Tooltip Card */
  .marker-card {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    opacity: 0;
    pointer-events: none;
    width: 160px;
    padding: 12px;
    border-radius: 10px;
    background: rgba(10, 10, 14, 0.9);
    border: 1px solid var(--color-outline-strong);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    display: grid;
    gap: 4px;
    text-align: center;
    transition: opacity 300ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 20;
  }

  .marker-card::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: rgba(10, 10, 14, 0.9);
  }

  .marker-card strong {
    font-size: 12px;
    font-weight: 600;
    color: #ffffff;
  }

  .marker-card span:not(.badge) {
    font-size: 10px;
    color: var(--color-on-surface-muted);
  }

  .marker-card .badge {
    margin-top: 4px;
    font-size: 9px;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 4px;
    width: fit-content;
    margin-inline: auto;
  }

  .badge.latency { background: rgba(41, 151, 255, 0.08); color: var(--color-primary-soft); }
  .badge.uptime { background: rgba(48, 209, 88, 0.08); color: #30d158; }
  .badge.speed { background: rgba(94, 92, 230, 0.08); color: var(--color-secondary-soft); }
  .badge.safe { background: rgba(255, 159, 10, 0.08); color: #ff9f0a; }

  /* Show Card on hover */
  .map-marker:hover .marker-card {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    pointer-events: auto;
  }

  .map-marker:hover .marker-core {
    transform: scale(1.3);
  }

  /* Animated connection styling */
  .map-active-path {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: trace-draw 6s ease-in-out infinite alternate;
  }

  @keyframes trace-draw {
    0% { stroke-dashoffset: 200; }
    100% { stroke-dashoffset: 0; }
  }

<script>
  const markers = document.querySelectorAll(".map-marker");
  markers.forEach((marker) => {
    marker.addEventListener("click", () => {
      const wasActive = marker.classList.contains("active-touch");
      markers.forEach((m) => m.classList.remove("active-touch"));
      if (!wasActive) marker.classList.add("active-touch");
    });
    marker.addEventListener("touchstart", (e) => {
      const wasActive = marker.classList.contains("active-touch");
      markers.forEach((m) => m.classList.remove("active-touch"));
      if (!wasActive) {
        marker.classList.add("active-touch");
        e.preventDefault();
      }
    }, { passive: true });
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest(".map-marker")) {
      markers.forEach((m) => m.classList.remove("active-touch"));
    }
  });
</script>

  @media (max-width: 768px) {
    .connectivity-map {
      aspect-ratio: 16 / 10;
    }
    .map-overlay {
      flex-direction: column;
      gap: 12px;
    }

    .overlay-header h4 {
      font-size: 15px;
    }

    .overlay-header p {
      font-size: 10px;
    }

    .live-status-pill {
      font-size: 9px;
      padding: 4px 10px;
    }

    .marker-card {
      width: 130px;
      padding: 8px;
    }

    .marker-card strong {
      font-size: 10px;
    }

    .marker-card span:not(.badge) {
      font-size: 9px;
    }

    .marker-card .badge {
      font-size: 8px;
      padding: 1px 5px;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .marker-card {
      opacity: 0;
      pointer-events: none;
      transition: opacity 300ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .map-marker.active-touch .marker-card {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
      pointer-events: auto;
    }
  }
</style>
