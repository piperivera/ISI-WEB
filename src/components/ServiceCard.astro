---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  text: string;
  tag: string;
  icon: string;
}

const { title, text, tag, icon } = Astro.props;
---

<article class="card service-card">
  <div class="service-head">
    <span class="icon-box">
      <Icon name={icon} />
    </span>
    <span class="tag">{tag}</span>
  </div>
  <h3>{title}</h3>
  <p>{text}</p>
</article>

<style>
  .service-card {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 28px;
  }

  .service-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .tag {
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(41, 151, 255, 0.1);
    color: var(--color-primary-soft);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  h3 {
    margin: 4px 0 0;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
    color: var(--color-on-surface-muted);
    font-size: 15px;
    line-height: 1.6;
    letter-spacing: -0.01em;
  }
</style>
