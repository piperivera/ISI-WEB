---
import BrandLogo from "./BrandLogo.astro";
import Icon from "./Icon.astro";
import ButtonLink from "./ButtonLink.astro";
import { navItems } from "../data/site";

interface Props {
  active: "inicio" | "nosotros" | "servicios" | "contacto";
}

const { active } = Astro.props;
---

<header class="site-header">
  <div class="shell header-inner">
    <BrandLogo />

    <nav class="desktop-nav" aria-label="Navegación principal">
      {
        navItems.map((item) => {
          const itemKey = item.label.toLowerCase();
          return (
            <a class:list={{ active: itemKey === active }} href={item.href}>
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="header-actions">
      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-toggle>
        <span class="menu-open"><Icon name="menu" size={20} /></span>
        <span class="menu-close"><Icon name="x" size={20} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav-overlay" data-mobile-overlay></div>
  <nav class="mobile-nav" aria-label="Navegación móvil" data-mobile-menu>
    <div class="mobile-nav-content">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <ButtonLink href="/contacto/" label="Contactar" />
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");
  const overlay = document.querySelector("[data-mobile-overlay]");

  function closeMenu() {
    menu?.classList.remove("is-open");
    overlay?.classList.remove("is-open");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Abrir menú");
    document.body.style.overflow = "";
  }

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("is-open") ?? false;
    overlay?.classList.toggle("is-open", isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    document.body.style.overflow = isOpen ? "hidden" : "";
  });

  overlay?.addEventListener("click", closeMenu);

  menu?.querySelectorAll("a, .btn").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Header scrolled state
  const header = document.querySelector(".site-header");
  if (header) {
    const handleScroll = () => {
      if (window.scrollY > 12) {
        header.classList.add("scrolled");
      } else {
        header.classList.remove("scrolled");
      }
    };
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
  }

  // Sync mobile nav top with actual header height
  const mobileNav = document.querySelector("[data-mobile-menu]") as HTMLElement;
  if (mobileNav && header) {
    const syncNavTop = () => {
      mobileNav.style.top = header.offsetHeight + "px";
    };
    syncNavTop();
    window.addEventListener("resize", syncNavTop);
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: rgba(0, 0, 0, 0);
    transition: background 220ms ease, border-color 220ms ease;
  }

  .site-header.scrolled {
    border-bottom: 1px solid var(--color-outline);
    background: rgba(5, 5, 7, 0.92);
  }

  .header-inner {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .desktop-nav a {
    position: relative;
    color: var(--color-on-surface-muted);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    transition: color 200ms ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a.active {
    color: var(--color-on-surface);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .menu-toggle {
    display: none;
    width: 36px;
    height: 36px;
    place-items: center;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--color-on-surface);
    cursor: pointer;
    transition: background 200ms ease;
  }

  .menu-toggle:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .menu-close {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .menu-open {
    display: none;
  }

  .menu-toggle[aria-expanded="true"] .menu-close {
    display: inline-flex;
  }

  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    z-index: -1;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .mobile-nav-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav {
    position: fixed;
    top: 52px;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 99;
    background: rgba(0, 0, 0, 0.95);
    transform: translateY(-8px);
    opacity: 0;
    pointer-events: none;
    transition: transform 350ms cubic-bezier(0.25, 0.46, 0.45, 0.94), opacity 300ms ease;
  }

  .mobile-nav.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav-content {
    display: grid;
    gap: 4px;
    padding: 20px 24px;
  }

  .mobile-nav a:not(.btn) {
    display: flex;
    min-height: 48px;
    align-items: center;
    padding: 0 12px;
    border-radius: 12px;
    color: var(--color-on-surface);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: background 200ms ease;
  }

  .mobile-nav a:not(.btn):hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .mobile-nav :global(.btn) {
    margin-top: 12px;
  }

  @media (max-width: 820px) {
    .desktop-nav,
    .header-actions > :global(.btn) {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }
  }
</style>
